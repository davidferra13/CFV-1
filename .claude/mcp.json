{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--browser", "chromium"]
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
      ]
    },
    "ollama-delegate": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/mcp-servers/ollama-delegate/server.mjs"],
      "env": {
        "OLLAMA_DELEGATE_URL": "http://localhost:11434",
        "OLLAMA_DELEGATE_MODEL": "gemma4:e4b",
        "OLLAMA_DELEGATE_TIMEOUT": "120000"
      }
    },
    "chefflow": {
      "type": "stdio",
      "command": "node",
      "args": [".claude/mcp-servers/chefflow/server.mjs"],
      "env": {
        "CHEFFLOW_URL": "http://localhost:3100",
        "CHEFFLOW_API_KEY": "cf_live_24a448b65bb9935a81efeab7b130c75bdc5b3fde2e0e890fcbf13cb829eda881",
        "CHEFFLOW_TIMEOUT": "15000"
      }
    },
    "mempalace": {
      "type": "stdio",
      "command": "py",
      "args": ["-m", "mempalace.mcp_server"],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "MEMPALACE_DIR": "c:/Users/david/Documents/CFv1"
      }
    }
  }
}
